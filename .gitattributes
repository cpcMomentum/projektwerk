# Nicht ins Release-Archiv: `git archive HEAD` respektiert `export-ignore`,
# damit Dev-/Test-/Konfig-Dateien gar nicht erst in Sign-Tree und Tarball
# landen (statt sie im Release-Skill von Hand zu entfernen). Damit bleibt
# Check 9 (Whitelist) von selbst grün. Fleet-Rollout: nc-app-tooling#21, #301.
#
# Behalten wird nur die Check-9-Whitelist: appinfo, CHANGELOG.md, css, img,
# js, l10n, lib, README.md, templates. projektwerk liefert KEIN vendor aus
# (keine Runtime-Deps), also darf composer.* mit raus.

/.github            export-ignore
/.githooks          export-ignore
/docs               export-ignore
/spike              export-ignore
/src                export-ignore
/tests              export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.nvmrc              export-ignore
composer.json       export-ignore
composer.lock       export-ignore
eslint.config.mjs   export-ignore
package.json        export-ignore
package-lock.json   export-ignore
playwright.config.ts export-ignore
tsconfig.json       export-ignore
vite.config.ts      export-ignore
vitest.config.ts    export-ignore
