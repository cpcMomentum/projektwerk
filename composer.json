{
  "name": "cpcmomentum/projektwerk",
  "description": "Projekte gemeinsam mit dem Kunden fuehren — Kanban fuer Nextcloud",
  "license": "AGPL-3.0-or-later",
  "type": "project",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "nextcloud/ocp": "^33.0 || ^34.0",
    "doctrine/dbal": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "OCA\\Projektwerk\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\Projektwerk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c tests/phpunit.xml",
    "test:unit": "phpunit -c tests/phpunit.xml"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4"
    }
  }
}
